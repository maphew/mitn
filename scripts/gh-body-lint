#!/usr/bin/env bash
# gh-body-lint — guard GitHub PR/comment/review Markdown before posting.
#
# This portable copy keeps every required helper inline so it has no dependency
# on project-specific maintainer automation.

set -euo pipefail

die() { echo "${0##*/}: $*" >&2; exit 1; }

strip_html_comments() {
  awk '
    {
      line = $0; out = ""
      while (1) {
        if (!inc) {
          s = index(line, "<!--")
          if (s) { out = out substr(line, 1, s - 1); line = substr(line, s + 4); inc = 1 }
          else { out = out line; break }
        } else {
          e = index(line, "-->")
          if (e) { line = substr(line, e + 3); inc = 0 } else break
        }
      }
      print out
    }
  '
}

# Count the words of a GitHub-facing body, excluding fenced code blocks and
# HTML comments (invisible on GitHub), and fail if over budget. Prints the
# count on success. An unterminated fence would silently exclude everything
# after it, so refuse it instead of undercounting.
word_budget() {
  local body_file="$1" max_words="$2"
  local fences words
  fences="$(grep -cE '^[[:space:]]*(```|~~~)' "$body_file" || true)"
  if (( ${fences:-0} % 2 != 0 )); then
    die "unterminated code fence in $body_file - close it before posting"
  fi
  words="$(awk '/^[[:space:]]*(```|~~~)/{in_code=!in_code; next} !in_code' "$body_file" \
    | strip_html_comments | wc -w)"
  if (( words > max_words )); then
    die "body is $words words, budget is $max_words: $body_file
Keep only what changes the maintainer's action: verdict plus top findings.
The full analysis stays in the local review note, not the upstream post."
  fi
  echo "$words"
}

# Warn (non-fatal) when a paragraph outside fenced code looks hard-wrapped:
# 2+ consecutive non-empty plain-text lines with no blank line between them,
# where a non-final line is under ~80 chars. GitHub renders every single
# newline in an issue/PR/comment body as a hard <br> (unlike a rendered .md
# file in a repo), so text wrapped at a fixed column width displays as
# broken short lines, especially on mobile - bodies should read one line
# per paragraph. Lines that legitimately stack without a blank line between
# them - headings, list items, table rows, blockquotes, explicit hard-break
# lines (two trailing spaces or a trailing backslash), setext underlines,
# link-reference definitions, and short "Label: value" metadata lines (as in
# a triage-report Environment block, where the stacking is the point) - are
# excluded and never open or extend a run. HTML comments (invisible on GitHub) are stripped before the check
# runs, via the same strip_html_comments helper word_budget uses, so a
# multi-line comment's interior and closing lines never get mistaken for
# paragraph text; strip_html_comments is line-count preserving so line
# numbers stay aligned with the original file. Prints "file:start-end: ..."
# for each flagged run and exits 0 if any were found, 1 otherwise, so
# callers can gate a warning message on the exit code the same way the
# em-dash check does.
hard_wrap_check() {
  local body_file="$1"
  strip_html_comments < "$body_file" | awk -v fname="$body_file" '
    function reset_run() { run_n = 0; delete run_lines; delete run_lens }
    function flush_run(   i, is_wrapped) {
      if (run_n >= 2) {
        is_wrapped = 0
        for (i = 1; i < run_n; i++) {
          if (run_lens[i] < 80) { is_wrapped = 1; break }
        }
        if (is_wrapped) {
          print fname ":" run_lines[1] "-" run_lines[run_n] \
            ": paragraph looks hard-wrapped (no blank line between short lines)"
          found = 1
        }
      }
      reset_run()
    }
    /^[[:space:]]*(```|~~~)/ { flush_run(); in_code = !in_code; next }
    in_code { next }
    /^[[:space:]]*$/                             { flush_run(); next }  # blank line (incl. stripped HTML comment)
    /^[[:space:]]*#+[[:space:]]/                  { flush_run(); next }  # heading
    /^[[:space:]]*>/                              { flush_run(); next }  # blockquote
    /^[[:space:]]*[-*+][[:space:]]/               { flush_run(); next }  # unordered list
    /^[[:space:]]*[0-9]+\.[[:space:]]/            { flush_run(); next }  # ordered list
    /\|/                                          { flush_run(); next }  # table row
    /^[[:space:]]*(=+|-+)[[:space:]]*$/           { flush_run(); next }  # setext underline
    /^[[:space:]]*\[[^]]+\]:[[:space:]]/          { flush_run(); next }  # link ref def
    /[[:space:]][[:space:]]$/                     { flush_run(); next }  # hard break (2 spaces)
    /\\$/                                         { flush_run(); next }  # hard break (backslash)
    /^[[:space:]]*[A-Za-z][A-Za-z0-9 \/_-]{0,24}:[[:space:]]/ { flush_run(); next }  # short "Label: value" metadata line, stacks intentionally
    {
      run_n++
      run_lines[run_n] = FNR
      run_lens[run_n] = length($0)
    }
    END { flush_run(); exit !found }
  '
}

lint_gh_body() {
  local body_file="$1"
  [[ -f "$body_file" ]] || die "GitHub body file not found: $body_file"

  local failed=0
  if grep -nF '\n' "$body_file" >&2; then
    echo "GitHub body contains literal \\n sequences; write real newlines and use --body-file" >&2
    failed=1
  fi
  if grep -nE '(^|[^[:alnum:]_])GH#[0-9]+' "$body_file" >&2; then
    echo "GitHub body contains GH# refs; use #1234 or owner/repo#1234 for GitHub autolinks" >&2
    failed=1
  fi
  # Owner style rule: no em dashes in agent prose. Fenced code blocks are exempt
  # (quoted source may legitimately contain them); like literal \n, this needs a
  # human rewrite rather than a mechanical --fix.
  if awk '/^[[:space:]]*(```|~~~)/{in_code=!in_code; next} !in_code && /\xe2\x80\x94/{print FILENAME ":" FNR ": " $0; found=1} END{exit !found}' "$body_file" >&2; then
    echo "GitHub body contains em dashes outside code fences; use regular dashes or rewrite" >&2
    failed=1
  fi
  # Warn only: this never sets $failed. See hard_wrap_check for the
  # GitHub-newlines-become-<br> rationale.
  if hard_wrap_check "$body_file" >&2; then
    echo "GitHub body may contain hard-wrapped paragraph(s) (line numbers above); GitHub turns single newlines into line breaks, so use one line per paragraph" >&2
  fi
  [[ "$failed" == 0 ]] || die "GitHub body lint failed: $body_file"
}

# Normalize safe GitHub body patterns in-place. This intentionally only changes
# same-repo shorthand refs; literal \n needs a human/template fix.
normalize_gh_body() {
  local body_file="$1"
  [[ -f "$body_file" ]] || die "GitHub body file not found: $body_file"
  perl -0pi -e 's/(^|[^[:alnum:]_])GH#([0-9]+)/$1#$2/g' "$body_file"
}

FIX=0
MAX_WORDS=""
FILES=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --fix) FIX=1; shift;;
    --max-words) [[ $# -ge 2 ]] || die "--max-words needs a value"; MAX_WORDS="$2"; shift 2;;
    --max-words=*) MAX_WORDS="${1#--max-words=}"; shift;;
    -h|--help)
      cat <<'USAGE'
Usage:
  scripts/gh-body-lint [--fix] [--max-words N] <body.md> [body2.md...]

Checks GitHub-facing Markdown bodies for common formatting mistakes:
  - literal \n sequences that render as text instead of line breaks
  - GH#1234 refs that do not autolink on GitHub
  - em dashes outside code fences
  - hard-wrapped paragraphs (warning only, does not fail): GitHub renders
    every single newline in an issue/PR/comment body as a hard line break,
    unlike a rendered .md file in a repo, so text wrapped at a fixed column
    width looks broken, especially on mobile - write one line per paragraph

With --fix, rewrites GH#1234 to #1234 in-place. Literal \n sequences are
reported but not rewritten because they may appear inside legitimate examples.

With --max-words N, also fails any body over N words (fenced code blocks
excluded from the count). Use this on public comments and reviews so the
posted text stays digestible; long analysis belongs in a local report.
USAGE
      exit 0
      ;;
    -*) die "unknown flag: $1";;
    *) FILES+=("$1"); shift;;
  esac
done

[[ "${#FILES[@]}" -gt 0 ]] || die "usage: gh-body-lint [--fix] [--max-words N] <body.md> [body2.md...]"
[[ -z "$MAX_WORDS" || "$MAX_WORDS" =~ ^[0-9]+$ ]] || die "--max-words must be a number (got '$MAX_WORDS')"

for file in "${FILES[@]}"; do
  if [[ "$FIX" == 1 ]]; then
    normalize_gh_body "$file"
  fi
  lint_gh_body "$file"
  if [[ -n "$MAX_WORDS" ]]; then
    word_budget "$file" "$MAX_WORDS" >/dev/null
  fi
done
