#!/usr/bin/env bash
# Smoke test for scripts/gh-body-lint. Run from anywhere; exits non-zero on
# the first failed expectation.

set -euo pipefail

LINT="$(cd "$(dirname "$0")" && pwd)/gh-body-lint"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

fail() { echo "FAIL: $*" >&2; exit 1; }

# 1. Clean body passes.
printf 'A clean body referencing #1234 and owner/repo#5678.\n' > "$TMP/clean.md"
"$LINT" "$TMP/clean.md" >/dev/null 2>&1 || fail "clean body should pass"

# 2. Literal \n fails.
printf 'bad body with literal \\n sequence\n' > "$TMP/literal.md"
if "$LINT" "$TMP/literal.md" >/dev/null 2>&1; then fail "literal \\n should fail"; fi

# 3. GH# ref fails.
printf 'see GH#1234 for details\n' > "$TMP/ghref.md"
if "$LINT" "$TMP/ghref.md" >/dev/null 2>&1; then fail "GH# ref should fail"; fi

# 4. --fix rewrites GH# and then passes.
"$LINT" --fix "$TMP/ghref.md" >/dev/null 2>&1 || fail "--fix should rewrite GH# and pass"
grep -q '#1234' "$TMP/ghref.md" || fail "--fix should leave #1234"
grep -q 'GH#' "$TMP/ghref.md" && fail "--fix should remove GH# prefix"

# 5. Word budget: over-budget fails, under-budget passes.
printf 'one two three four five six\n' > "$TMP/words.md"
"$LINT" --max-words 10 "$TMP/words.md" >/dev/null 2>&1 || fail "under-budget should pass"
if "$LINT" --max-words 3 "$TMP/words.md" >/dev/null 2>&1; then fail "over-budget should fail"; fi

# 6. Fenced code is excluded from the count.
printf 'two words\n```\ncode words never counted here at all\n```\n' > "$TMP/fenced.md"
"$LINT" --max-words 2 "$TMP/fenced.md" >/dev/null 2>&1 || fail "fenced code should be excluded from word count"

# 7. Unterminated fence is refused.
printf 'text\n```\nunclosed\n' > "$TMP/unterm.md"
if "$LINT" --max-words 100 "$TMP/unterm.md" >/dev/null 2>&1; then fail "unterminated fence should fail"; fi

# 8. Hard-wrapped paragraph triggers a warning (stderr) but still passes.
printf 'This is a paragraph that has been wrapped at\napproximately seventy columns for readability\nwhich looks broken when rendered as a GitHub br.\n' \
  > "$TMP/hardwrapped.md"
"$LINT" "$TMP/hardwrapped.md" >/dev/null 2>"$TMP/hardwrapped.err" \
  || fail "hard-wrapped paragraph is a warning, not a failure"
grep -q 'hard-wrapped' "$TMP/hardwrapped.err" || fail "hard-wrapped paragraph should warn on stderr"

# 9. A list (no blank lines between items) does not warn.
printf -- '- item one is quite short\n- item two is quite short\n- item three is quite short\n' \
  > "$TMP/list.md"
"$LINT" "$TMP/list.md" >/dev/null 2>"$TMP/list.err" || fail "list should pass"
[[ ! -s "$TMP/list.err" ]] || fail "list should not warn about hard-wrapping: $(cat "$TMP/list.err")"

# 10. Fenced code containing wrapped text does not warn.
printf 'Some text.\n\n```\nline one is fairly short text here\nline two is also fairly short as well\n```\n' \
  > "$TMP/fenced-wrapped.md"
"$LINT" "$TMP/fenced-wrapped.md" >/dev/null 2>"$TMP/fenced-wrapped.err" || fail "fenced wrapped text should pass"
[[ ! -s "$TMP/fenced-wrapped.err" ]] || fail "fenced code should not warn about hard-wrapping: $(cat "$TMP/fenced-wrapped.err")"

# 11. One-line-per-paragraph body does not warn.
printf '# Heading\n\nFirst paragraph as a single line.\n\nSecond paragraph, also a single line.\n' \
  > "$TMP/oneliner.md"
"$LINT" "$TMP/oneliner.md" >/dev/null 2>"$TMP/oneliner.err" || fail "one-line-per-paragraph body should pass"
[[ ! -s "$TMP/oneliner.err" ]] || fail "one-line-per-paragraph body should not warn: $(cat "$TMP/oneliner.err")"

# 12. A multi-line HTML comment's interior and closing lines do not warn.
printf '<!--\nthis is a comment line here\nanother comment line here\n-->\n\nReal paragraph.\n' \
  > "$TMP/htmlcomment.md"
"$LINT" "$TMP/htmlcomment.md" >/dev/null 2>"$TMP/htmlcomment.err" || fail "HTML comment body should pass"
[[ ! -s "$TMP/htmlcomment.err" ]] || fail "multi-line HTML comment should not warn about hard-wrapping: $(cat "$TMP/htmlcomment.err")"

# 13. Stacked "Label: value" metadata lines (triage-report Environment block)
# do not warn - the hard breaks there are intentional.
printf 'OS: Linux 7.0.12-201.fc44.x86_64\nNode: v26.7.0\n\nA real one-line paragraph after the metadata block.\n' \
  > "$TMP/metadata.md"
"$LINT" "$TMP/metadata.md" >/dev/null 2>"$TMP/metadata.err" || fail "metadata block body should pass"
[[ ! -s "$TMP/metadata.err" ]] || fail "Label: value metadata lines should not warn: $(cat "$TMP/metadata.err")"

# 14. A label longer than 25 characters remains ordinary paragraph text.
printf 'ABCDEFGHIJKLMNOPQRSTUVWXYZ: value\nAnother short prose line.\n' \
  > "$TMP/long-label.md"
"$LINT" "$TMP/long-label.md" >/dev/null 2>"$TMP/long-label.err" \
  || fail "long label body should pass with a warning"
grep -q 'hard-wrapped' "$TMP/long-label.err" || fail "label longer than 25 characters should still warn"

echo "ok: all gh-body-lint smoke tests passed"
