
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Local Trilium source worktrees and build/runtime state
.worktrees/
worktrees/
node_modules/
dist/
build/

# Local environment and caches
.env
.cache/
tmp/
.bv/
.bt/
.amp/portals/*

# Beads runtime state not covered by .beads/.gitignore
.beads/interactions.jsonl
.beads/last-touched
.beads/.session-start

# Retrospective digests can contain transcript excerpts and private paths
retro/digests/

# Vault data is local runtime state; keep it out of this public repository
vaults/

# BEGIN swamp managed section - DO NOT EDIT

# Runtime data (not needed in version control)
.swamp/

# Local extension sources (developer-specific, not shared)
.swamp-sources.yaml

# Claude Code configuration (managed by swamp)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
# END swamp managed section
